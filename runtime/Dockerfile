# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS api-bot-runtime

WORKDIR /app
COPY --chown=node:node tools/funnelmetry-api-bot.mjs tools/funnelmetry-api-bot.mjs
USER node
ENTRYPOINT ["node", "tools/funnelmetry-api-bot.mjs"]

FROM node:22-bookworm-slim AS dependencies

RUN corepack enable && corepack prepare pnpm@10.11.1 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY .npmrc .npmrc
COPY apps/backend/package.json apps/backend/package.json
COPY apps/storefront/package.json apps/storefront/package.json
RUN --mount=type=secret,id=npm_token,required=true \
    NODE_AUTH_TOKEN="$(cat /run/secrets/npm_token)" pnpm install --frozen-lockfile

FROM dependencies AS validate

COPY . .

RUN --mount=type=secret,id=npm_token,required=true \
    NODE_AUTH_TOKEN="$(cat /run/secrets/npm_token)" pnpm --filter @dtc/backend build
RUN --mount=type=secret,id=npm_token,required=true \
    NODE_AUTH_TOKEN="$(cat /run/secrets/npm_token)" pnpm --filter @dtc/storefront exec tsc --noEmit --pretty false

# `medusa start` serves the compiled Admin bundle generated by the validate
# stage. The backend image does not need to build the storefront.
FROM validate AS backend-runtime

# Packages are already installed. Do not retain registry configuration that
# references the build-only token in the running application image.
RUN rm -f .npmrc

# NEXT_PUBLIC_* values are intentionally build arguments: Next.js inlines them
# into browser bundles during `next build`. They are public configuration, not
# backend signing secrets. The server must rebuild the storefront when they
# change.
FROM validate AS storefront-build

ARG NEXT_PUBLIC_MEDUSA_BACKEND_URL
ARG NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_DEFAULT_REGION=dk
ARG NEXT_PUBLIC_FUNNELMETRY_BROWSER_WRITE_KEY

ENV NEXT_PUBLIC_MEDUSA_BACKEND_URL=${NEXT_PUBLIC_MEDUSA_BACKEND_URL} \
    NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=${NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY} \
    NEXT_PUBLIC_DEFAULT_REGION=${NEXT_PUBLIC_DEFAULT_REGION} \
    NEXT_PUBLIC_FUNNELMETRY_BROWSER_WRITE_KEY=${NEXT_PUBLIC_FUNNELMETRY_BROWSER_WRITE_KEY} \
    NEXT_TELEMETRY_DISABLED=1

RUN pnpm --filter @dtc/storefront build

FROM storefront-build AS storefront-runtime

# Keep the production output built above, but drop the registry configuration
# that only exists to resolve private packages during the build.
RUN rm -f .npmrc
