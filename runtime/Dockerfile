# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS dependencies

RUN corepack enable && corepack prepare pnpm@10.11.1 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY .npmrc .npmrc
COPY apps/backend/package.json apps/backend/package.json
COPY apps/storefront/package.json apps/storefront/package.json
RUN --mount=type=secret,id=npm_token,required=true \
    NODE_AUTH_TOKEN="$(cat /run/secrets/npm_token)" pnpm install --frozen-lockfile

FROM dependencies AS validate

COPY . .

RUN --mount=type=secret,id=npm_token,required=true \
    NODE_AUTH_TOKEN="$(cat /run/secrets/npm_token)" pnpm --filter @dtc/backend build
RUN --mount=type=secret,id=npm_token,required=true \
    NODE_AUTH_TOKEN="$(cat /run/secrets/npm_token)" pnpm --filter @dtc/storefront exec tsc --noEmit --pretty false

# `medusa start` serves the compiled Admin bundle generated by the validate
# stage. This avoids relying on the Vite development server in the runtime
# container, while retaining validation as part of every runtime image build.
FROM validate AS runtime

# Packages are already installed. Do not retain registry configuration that
# references the build-only token in the running application image.
RUN rm -f .npmrc
